# ─────────────────────────────────────────────
# MCP Gateway — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Gateway ──────────────────────────────────
# Comma-separated API keys (generate with: python3 -c "import secrets; print(secrets.token_hex(24))")
MCP_API_KEYS=change-me-before-use

HOST=0.0.0.0
PORT=8000

# ── QA Tools ─────────────────────────────────
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=your-jira-api-token

TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_USER=you@company.com
TESTRAIL_KEY=your-testrail-api-key

XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

PLAYWRIGHT_PROJECT_PATH=./

ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# ── Dev Tools ────────────────────────────────
GITHUB_TOKEN=ghp_your-github-token

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-token

AZURE_ORG=your-org
AZURE_TOKEN=your-azure-pat

CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_EMAIL=you@company.com
CONFLUENCE_TOKEN=your-confluence-token

LINEAR_API_KEY=your-linear-api-key

# ── General Tools ────────────────────────────
SLACK_TOKEN=xoxb-your-slack-bot-token

NOTION_TOKEN=secret_your-notion-token

ASANA_TOKEN=your-asana-token

GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

FIGMA_TOKEN=your-figma-token

# ── Database (optional) ───────────────────────
DATABASE_URL=postgresql://user:pass@localhost/dbname
