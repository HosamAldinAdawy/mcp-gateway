# MCP Gateway — Full Configuration
# Copy to .env and fill your values

# ── Gateway Core ──────────────────────────
MCP_API_KEYS=your-secret-key-here
GATEWAY_PORT=8000
RATE_LIMIT_PER_MINUTE=60
AUDIT_LOG_PATH=logs/audit.jsonl
ALLOWED_ORIGINS=*

# ── QA Tools ──────────────────────────────
# Jira (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=your-jira-api-token

# TestRail (TestRail -> My Settings -> API Keys)
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=you@company.com
TESTRAIL_TOKEN=your-testrail-api-key

# Xray (Xray -> API Keys in Jira settings)
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# Zephyr Scale (Zephyr -> API Access Tokens)
ZEPHYR_TOKEN=your-zephyr-api-token
ZEPHYR_PROJECT_KEY=QA

# ── Dev Tools ─────────────────────────────
# GitHub (Settings -> Developer settings -> Personal access tokens)
GITHUB_TOKEN=your-github-personal-access-token

# Azure DevOps (User Settings -> Personal Access Tokens)
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_TOKEN=your-pat-token
AZURE_DEVOPS_PROJECT=your-project

# ── General Tools ─────────────────────────
# Filesystem
FS_ROOT=/home/user/mcp-files

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword
DB_TYPE=postgresql

# Slack (api.slack.com -> OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
